# Docker service names. For a backend running on the host, use localhost instead.

# ==============================
# LLM Providers
# ==============================
GROQ_API_KEY=

# ==============================
# Infrastructure URLs (Docker internal)
# ==============================
LLM_MODEL=openai/gpt-oss-120b
# Ordered JSON array. Set [] for primary only. Safeguard is a safety classifier;
# remove it from this array if it does not meet your document-answer quality bar.
LLM_FALLBACK_MODELS=["openai/gpt-oss-20b","qwen/qwen3.8-27b","openai/gpt-oss-safeguard-20b"]
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ==============================
# Application Settings
# ==============================
DATA_DIR=/app/data
MAX_UPLOAD_BYTES=52428800
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# The base Compose file uses CPU. docker-compose.gpu.yml defaults both to CUDA.
# Optional overrides: EMBEDDING_DEVICE=cpu / RERANKER_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
RERANKER_BATCH_SIZE=4
LOG_LEVEL=info
